{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PgyPicker",
  "version": "1.2.5",
  "identifier": "com.pgypicker.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PgyPicker · 蒲公英选号器",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "visible": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "externalBin": ["binaries/pgy-backend"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
